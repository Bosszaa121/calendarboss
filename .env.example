# GEMINI_API_KEY: Server-side Gemini API key used by server.ts and /api/* serverless functions.
# AI Studio automatically injects this at runtime from Settings > Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Upstash Redis / Vercel KV REST API (Server-side only — never expose to browser)
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

